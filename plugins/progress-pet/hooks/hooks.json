{
  "description": "Motchi lifecycle observers. Direct decisions use the separately registered user PermissionRequest hook; install with install_approval_hook.py.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/skills/completion-pet/scripts/dog_bridge.py\" --hook",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/skills/completion-pet/scripts/dog_bridge.py\" --hook",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/skills/completion-pet/scripts/dog_bridge.py\" --hook",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/skills/completion-pet/scripts/dog_bridge.py\" --hook",
            "timeout": 5
          }
        ]
      }
    ],
    "Interrupt": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/skills/completion-pet/scripts/dog_bridge.py\" --hook",
            "timeout": 1
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/skills/completion-pet/scripts/dog_bridge.py\" --hook",
            "timeout": 1
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "request_user_input|request_user_input_async|functions.request_user_input|functions.request_user_input_async",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/skills/completion-pet/scripts/dog_bridge.py\" --hook",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
